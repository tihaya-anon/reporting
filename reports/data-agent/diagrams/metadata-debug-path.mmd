flowchart LR
  Fail["失败告警"] --> Dagster["Dagster<br/>统一监控平台"]
  Dagster --> Locate["元数据指针<br/>run asset partition task"]
  Locate --> AWS["AWS 下钻<br/>logs storage tables"]
  Locate --> Ingest{"采集失败?"}
  Ingest --> Dlt["dlt logs / state<br/>pagination request state"]
  Dlt --> API["API 证据<br/>page cursor schema"]
  AWS --> Fix["修复代码 / IaC / contract"]
  API --> Fix
  Fix --> Retry["同一 partition<br/>重新验证"]
